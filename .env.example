MONGODB_URI=mongodb://127.0.0.1:27017/baba_broker
PORT=5000

# Seeded into the Users collection as the bootstrap admin account on first boot.
ADMIN_EMAIL=admin@bababroker.com
ADMIN_PASSWORD=Baba@123

# Long random value. Must not change once issued or all staff sessions are invalidated.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
